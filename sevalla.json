{
  "name": "cncf-issue-tracker",
  "version": "1.0.0",
  "description": "CNCF Projects Issue Tracker Bot for Telegram",
  "start": "python cncf_issue_tracker.py",
  "buildCommand": "pip install -r requirements.txt",
  "healthCheckPath": "/health",
  "restart": {
    "policy": "on-failure",
    "maxRetries": 10
  }
}
